# dl-load invalid reads (glibc dynamic linker / RPATH parsing)
{
    dl_load_invalid_read_1
    Memcheck:Addr8
    fun:strncmp
    fun:is_dst
    fun:_dl_dst_count
    fun:expand_dynamic_string_token
    fun:fillin_rpath.isra.0
    fun:decompose_rpath
    fun:cache_rpath
}
{
    dl_load_invalid_read_2
    Memcheck:Addr8
    fun:strncmp
    fun:is_dst
    fun:_dl_dst_substitute
    fun:fillin_rpath.isra.0
    fun:decompose_rpath
    fun:cache_rpath
}

# glibc dl_find_object_update leak (definitely lost, internal to ld.so)
{
    dl_find_object_update_leak
    Memcheck:Leak
    match-leak-kinds: definite
    fun:malloc
    fun:malloc
    fun:_dl_find_object_update
    fun:dl_open_worker_begin
    fun:_dl_catch_exception
    fun:dl_open_worker
}

# libX11 / GLFW XIM leak (definitely lost, internal to libX11)
{
    glfw_x11_xim_leak
    Memcheck:Leak
    match-leak-kinds: definite
    fun:calloc
    fun:_XimOpenIM
    fun:_XimRegisterIMInstantiateCallback
    fun:XRegisterIMInstantiateCallback
    fun:_glfwInitX11
    fun:glfwInit
    fun:main
}
